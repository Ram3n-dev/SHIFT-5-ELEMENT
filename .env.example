# Скопируйте в .env и при необходимости поменяйте значения. Файл .env в git не попадает.

# Порт, на котором откроется приложение: http://localhost:8080
APP_PORT=8080

# Объяснения через языковую модель. По умолчанию выключены — работают шаблоны, ключи не нужны.
# Пример для Ollama на этом же компьютере:
#   LLM_ENABLED=true
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=название-модели-из-ollama-list
LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=
LLM_API_KEY=

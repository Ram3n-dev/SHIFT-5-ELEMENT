# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Порт приложения: http://localhost:8080
APP_PORT=8080

# База данных (контейнер db). Порт 5433 открыт только на этом компьютере.
DB_PASSWORD=limitplus
DB_PORT=5433

# Вход через Google. Пусто — работает только демо-вход. Как получить ключи — в README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEMO_LOGIN=true

# ИИ (RouterAI, OpenAI-совместимый API). Без ключа Енот отвечает по шаблонам.
LLM_ENABLED=false
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro-0813
LLM_API_KEY=
